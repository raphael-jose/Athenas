{
  "name": "athenas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Athenas 🇫🇷✨ — O RPG mais fofo para aprender francês. PWA estática compatível com GitHub Pages.",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite",
    "build": "node scripts/prepare.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "npx wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.4"
  }
}
