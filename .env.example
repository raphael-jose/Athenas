[TEMPLATE]
# ══════════════════════════════════════════════════════════════
#  ANTENAS 🇫🇷✨ — Variáveis de ambiente
#  Copie para `.env` se quiser (opcional — o app roda sem ele).
#  NUNCA commite o arquivo `.env`. NUNCA coloque chaves reais no frontend.
# ══════════════════════════════════════════════════════════════

# ── Provedor de IA ─────────────────────────────────────────────
# mock     → respostas locais, funciona 100% offline (padrão)
# ollama   → chama a API do Ollama (ou compatível com OpenAI /v1/chat/completions)
# proxy    → chama um endpoint intermediário seu (serverless, ex.: Cloudflare Worker)
VITE_AI_PROVIDER=mock

# ── Ollama Cloud (compatível com OpenAI) ───────────────────────
# ATENÇÃO: variáveis VITE_* são embutidas no bundle e ficam visíveis
# no JavaScript público do GitHub Pages. Por isso NÃO existe
# VITE_OLLAMA_API_KEY — uma chave real aqui vazaria para todo mundo.
# A chave é digitada pelo usuário em Perfil → Configurações → IA e
# fica só no localStorage do navegador dele (bring-your-own-key).
# Para produção com chave central, use o proxy serverless abaixo.
# Endpoint OpenAI-compatível do Ollama Cloud — NÃO use ".../api" (prefixo
# da API nativa; /v1/chat/completions ali dá 404). qwen3:8b é modelo LOCAL,
# não existe no cloud — gpt-oss:20b é um dos modelos cloud da conta grátis.
VITE_OLLAMA_BASE_URL=https://ollama.com
VITE_OLLAMA_MODEL=gpt-oss:20b

# ── Proxy serverless (recomendado para produção) ───────────────
# Ex.: https://seu-proxy.workers.dev — veja SECURITY.md para o exemplo.
VITE_AI_PROXY_URL=

# ── Logo ───────────────────────────────────────────────────────
# Caminho (na raiz do projeto) de um PNG para usar como logo/ícone.
# Padrão: o primeiro *.png encontrado na raiz.
# LOGO_PATH=meu-logo.png

# ── Ajustes opcionais ──────────────────────────────────────────
# DAILY_XP_GOAL=50   # meta diária de XP
